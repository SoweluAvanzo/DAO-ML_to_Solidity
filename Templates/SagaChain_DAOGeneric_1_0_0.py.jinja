        if not self.can_control(self.roles.get(sender, 0), role):
            raise {{dao_name}}Error("cannot revoke permission, as the control relation is lacking")
        role_index = role & self.ID_MASK
        self.role_permissions[role_index] = self.role_permissions.get(role_index, 0) & ~(1 << permission_index)
        self._emit("PermissionRevoked", role=role, permission=permission_index)

