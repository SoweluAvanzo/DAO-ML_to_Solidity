    def grant_permission(self, sender: str, role: int, permission_index: int):
        self._require_permission(sender, permission_index)
        if not self.can_control(self.roles.get(sender, 0), role):
            raise {{dao_name}}Error("cannot grant permission, as the control relation is lacking")
        role_index = role & self.ID_MASK
        self.role_permissions[role_index] = self.role_permissions.get(role_index, 0) | (1 << permission_index)
        self._emit("PermissionGranted", role=role, permission=permission_index)

