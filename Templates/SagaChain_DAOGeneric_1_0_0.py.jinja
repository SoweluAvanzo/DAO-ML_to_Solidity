    def can_control(self, controller_role: int, controlled_role: int) -> bool:
        """"CAN the sender control the target user (through its role)?" - same bit
        arithmetic as the Solidity `canControl`, since it is the direct encoding of the
        SagaOS object-graph edge described in Whitepaper Sec. 5.3."""
        controlled_bitmask = controlled_role >> self.CONTROL_RELATION_ID_BIT_SIZE
        controller_index_bit = 1 << (controller_role & self.ID_MASK)
        return (controlled_bitmask & controller_index_bit) != 0

    def _require_controlled_by(self, sender: str, user_role_id: int, allow_null_role_user: bool, new_role_id: int):
        index_new_role = new_role_id & self.CONTROL_RELATION_MASK
        if not (index_new_role < self.ENTITIES_AMOUNT):
            raise {{dao_name}}Error("the new role must be a valid one")

        sender_role = self.roles.get(sender, 0)
        sender_role_index_bit = 1 << (sender_role & self.ID_MASK)
        allowed_null = allow_null_role_user and user_role_id == 0
        controls_user = ((user_role_id >> self.CONTROL_RELATION_ID_BIT_SIZE) & sender_role_index_bit) != 0
        if not (allowed_null or controls_user):
            raise {{dao_name}}Error("the given controller can't perform the given operation on the given controlled user")

        if not self.can_control(sender_role, self.ALL_ROLES[index_new_role]):
            raise {{dao_name}}Error("the given controller can't perform the given operation on the given controlled role")

    def _require_permission(self, executor: str, permission_index: int):
