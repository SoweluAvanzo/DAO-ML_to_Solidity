        # `roles` stores the full packed value (index + control bitmask, Sec. 5.3) - same
        # masking the Solidity `hasPermission` modifier applies before the mapping lookup.
        if (self.role_permissions.get(self.roles.get(executor, 0) & self.ID_MASK, 0) & (1 << permission_index)) == 0:
            raise {{dao_name}}Error("User does not have this permission")

