    # ------------------------------------------------------------------
    # SagaChain Sec. 6 / Sec. 8 - Operational Smart Assets & their governance layer
    #
    # NOTE ON IMMUTABILITY (Whitepaper Sec. 8.1): "A governance asset is considered
    # immutable once instantiated." The methods below - propose/vote/finalize - ARE
    # that governance asset: they are never themselves a valid ChangeType target, only
    # the OperationalSmartAsset entries they act upon can be changed.
    # ------------------------------------------------------------------

    def _require_asset_governor(self, sender: str, asset_index: int):
        asset = self.operational_assets[asset_index]
        self._require_permission(sender, asset.governing_permission_index)

    def propose_change_request(
        self,
        sender: str,
        asset_index: int,
        change_type: ChangeType,
        param_key: Optional[str] = None,
        param_value: Any = None,
        new_algorithm: Optional[SmartAssetAlgorithm] = None,
    ) -> int:
        self._require_asset_governor(sender, asset_index)
        asset = self.operational_assets[asset_index]
        if asset.state == SmartAssetState.DELETED:
            raise {{dao_name}}Error("asset has been deleted")
        if asset_index in self._open_request_by_asset:
            # SagaChain Sec. 8.3: change requests are FIFO; an asset may have only one outstanding request at a time
            raise {{dao_name}}Error("asset already has an outstanding change request")
        if change_type == ChangeType.ALGORITHM_CHANGE:
            if new_algorithm is None:
                raise {{dao_name}}Error("invalid algorithm replacement")
            if asset.algorithm is not None and inspect.signature(new_algorithm) != inspect.signature(asset.algorithm):
                # SagaChain Sec. 8.3: "the new function must match the exact signature of the old one"
                raise {{dao_name}}Error("replacement algorithm's signature does not match the current one")

        request_id = len(self.change_requests)
        self.change_requests.append(ChangeRequest(
            asset_index=asset_index,
            change_type=change_type,
            proposer=sender,
            param_key=param_key,
            param_value=param_value,
            new_algorithm=new_algorithm,
            voting_deadline=time.time() + asset.voting_duration_seconds,
        ))
        self._open_request_by_asset[asset_index] = request_id
        self._emit("ChangeRequestProposed", request_id=request_id, asset_index=asset_index, change_type=change_type.name, proposer=sender)
        return request_id

    def vote_change_request(self, sender: str, request_id: int, support: bool):
        cr = self.change_requests[request_id]
        if cr.executed or cr.discarded:
            raise {{dao_name}}Error("change request already settled")
        if time.time() >= cr.voting_deadline:
            raise {{dao_name}}Error("voting window closed")

        if not cr.committee_approved:
            # SagaChain Sec. 8.1 "Registry of Committee Members": reuses the DAO's own role/permission system
            self._require_asset_governor(sender, cr.asset_index)
            if sender in cr.votes_for or sender in cr.votes_against:
                raise {{dao_name}}Error("already voted")
            (cr.votes_for if support else cr.votes_against).add(sender)
            self._emit("ChangeRequestVoted", request_id=request_id, voter=sender, support=support, plenary=False)
        elif cr.plenary_open:
            if sender not in self.roles:
                # SagaChain Sec. 8.2: one person, one vote - never weighted by permissions or tokens held
                raise {{dao_name}}Error("only DAO members may cast a plenary vote")
            if sender in cr.plenary_votes_for or sender in cr.plenary_votes_against:
                raise {{dao_name}}Error("already voted")
            (cr.plenary_votes_for if support else cr.plenary_votes_against).add(sender)
            self._emit("ChangeRequestVoted", request_id=request_id, voter=sender, support=support, plenary=True)
        else:
            raise {{dao_name}}Error("no open voting round for this change request")

    @staticmethod
    def _threshold_met(votes_for: int, votes_against: int, majority_type: MajorityType) -> bool:
        total = votes_for + votes_against
        if total == 0:
            return False
        if majority_type == MajorityType.UNANIMOUS:
            return votes_against == 0
        if majority_type == MajorityType.SUPERMAJORITY:
            return votes_for * 3 >= total * 2
        return votes_for * 2 > total  # MajorityType.MAJORITY

    def finalize_change_request(self, request_id: int):
        cr = self.change_requests[request_id]
        if cr.executed or cr.discarded:
            raise {{dao_name}}Error("change request already settled")
        asset = self.operational_assets[cr.asset_index]

        if not cr.committee_approved:
            if time.time() < cr.voting_deadline:
                raise {{dao_name}}Error("committee voting still open")
            if self._threshold_met(len(cr.votes_for), len(cr.votes_against), asset.majority_type):
                cr.committee_approved = True
                if asset.requires_community_ratification:
                    # SagaChain Sec. 8.3: "Community plenary vote (for major changes)"
                    cr.plenary_open = True
                    cr.voting_deadline = time.time() + asset.voting_duration_seconds
                else:
                    self._apply_change_request(request_id)
            else:
                cr.discarded = True
                del self._open_request_by_asset[cr.asset_index]
                self._emit("ChangeRequestAbandoned", request_id=request_id, asset_index=cr.asset_index, reason="committee vote failed or timed out")
        elif cr.plenary_open:
            if time.time() < cr.voting_deadline:
                raise {{dao_name}}Error("plenary voting still open")
            if len(cr.plenary_votes_for) > len(cr.plenary_votes_against):
                self._apply_change_request(request_id)
            else:
                cr.discarded = True
                del self._open_request_by_asset[cr.asset_index]
                self._emit("ChangeRequestAbandoned", request_id=request_id, asset_index=cr.asset_index, reason="plenary ratification failed or timed out")

    def _apply_change_request(self, request_id: int):
        cr = self.change_requests[request_id]
        asset = self.operational_assets[cr.asset_index]

        if cr.change_type in (ChangeType.START, ChangeType.RESET):
            asset.state = SmartAssetState.ACTIVE
        elif cr.change_type == ChangeType.STOP:
            asset.state = SmartAssetState.STOPPED
        elif cr.change_type == ChangeType.PAUSE:
            asset.state = SmartAssetState.PAUSED
        elif cr.change_type == ChangeType.DELETE_ASSET:
            asset.state = SmartAssetState.DELETED
        elif cr.change_type == ChangeType.PARAMETER_CHANGE:
            asset.parameters[cr.param_key] = cr.param_value
            self._emit("SmartAssetParameterChanged", asset_index=cr.asset_index, param_key=cr.param_key, new_value=cr.param_value)
        elif cr.change_type == ChangeType.ALGORITHM_CHANGE:
            asset.algorithm = cr.new_algorithm
            self._emit("SmartAssetAlgorithmChanged", asset_index=cr.asset_index)
        # ChangeType.CUSTOM: no built-in effect; a swapped `algorithm` callable is expected
        # to interpret custom change requests on its own terms.

        cr.executed = True
        del self._open_request_by_asset[cr.asset_index]
        self._emit("SmartAssetStateChanged", asset_index=cr.asset_index, new_state=asset.state.name)
        self._emit("ChangeRequestExecuted", request_id=request_id, asset_index=cr.asset_index, change_type=cr.change_type.name)

    def execute_algorithm(self, sender: str, asset_index: int, data: Any = None) -> Any:
        """Day-to-day use of an Operational Smart Asset: delegates to its current,
        governance-swappable `algorithm` callable - the Python analogue of calling
        into a Diamond facet whose address governance may later replace."""
        self._require_asset_governor(sender, asset_index)
        asset = self.operational_assets[asset_index]
        if asset.state != SmartAssetState.ACTIVE:
            raise {{dao_name}}Error("Operational Smart Asset is not Active")
        if asset.algorithm is None:
            raise {{dao_name}}Error("no algorithm implementation set")
        return asset.algorithm(self, asset_index, data)

    def get_operational_asset_state(self, asset_index: int) -> SmartAssetState:
        return self.operational_assets[asset_index].state

    def get_asset_parameter(self, asset_index: int, param_key: str) -> Any:
        return self.operational_assets[asset_index].parameters.get(param_key)
